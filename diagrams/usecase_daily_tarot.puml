@startuml Daily Tarot Card Use Case
left to right direction
skinparam packageStyle rectangle

actor "User" as user

rectangle "Tarotales System" {
  usecase "View Daily Tarot" as UC1
  usecase "Draw Daily Card" as UC2
  usecase "View Card Details" as UC3
  usecase "Reset Daily Status" as UC4
  usecase "Navigate to Monthly Tarot" as UC5
}

user --> UC1
user --> UC2
user --> UC3
user --> UC5

UC2 ..> UC3 : <<include>>
UC4 ..> UC1 : <<extend>>

note right of UC2
  User can only draw 
  one card per day
  (6AM reset)
end note

note right of UC4
  System automatically 
  resets at 6AM daily
end note

@enduml
